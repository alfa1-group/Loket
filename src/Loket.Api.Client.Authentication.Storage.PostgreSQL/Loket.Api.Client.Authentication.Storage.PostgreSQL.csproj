<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Loket Authentication Token Storage using PostgreSQL</Description>
    <TargetFramework>net8.0</TargetFramework>
    <PackageTags>Exact;Loket;C#;APIs;Client;Authentication;Tokens;RefreshToken;Storage;SQL;PostgreSQL</PackageTags>
